# Next.js (copy to .env.local)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CONVEX_URL=
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Convex deployment environment (set with `npx convex env set`)
# CLERK_JWT_ISSUER_DOMAIN=https://your-clerk-frontend-api-url

# Local n8n (copy only these to .env.n8n)
N8N_ENCRYPTION_KEY=
N8N_HOST=localhost

# Optional isolated authenticated Playwright setup (development only)
# E2E_CLERK_USER_EMAIL=test+clerk_test@example.com
# E2E_SOCIETY_NAME=Your seeded development society
